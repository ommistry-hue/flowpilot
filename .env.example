# Copy to .env and fill in. docker compose reads this file automatically.

# --- AI (optional) ---------------------------------------------------------
# Leave empty to run without AI features.
# Provider: anthropic | openai  (openai = any OpenAI-compatible API, e.g. Ollama, OpenRouter)
FlowPilot__AI__Provider=anthropic
FlowPilot__AI__ApiKey=
FlowPilot__AI__Model=claude-sonnet-5-5
# Only needed for OpenAI-compatible endpoints, e.g. http://host.docker.internal:11434/v1 for Ollama
# FlowPilot__AI__BaseUrl=

# --- Security (required) -----------------------------------------------------
# API key for /api/* and /hubs/* (send it as the X-Api-Key header; the UI asks for it once).
# docker compose refuses to start without it. Generate one with: openssl rand -hex 32
FLOWPILOT_API_KEY=change-me

# --- Secrets for workflows (optional) ----------------------------------------
# Every FLOWPILOT_SECRET_<NAME> variable is available in expressions as secrets.<NAME>,
# e.g. {{ secrets.SLACK_WEBHOOK }}. Values are masked as *** in run history and logs.
# FLOWPILOT_SECRET_SLACK_WEBHOOK=https://hooks.slack.com/services/...

# --- Database ------------------------------------------------------------------
# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me
